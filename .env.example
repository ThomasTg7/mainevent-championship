DATABASE_URL="postgres://postgres:postgres@localhost:5432/guerra_campal"

# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-value"
BETTER_AUTH_URL="http://localhost:3000"

# Login con Google (opcional). Si faltan, el botón de Google no aparece.
# Ver docs/configuracion-externa.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correos (invitaciones y recuperar contraseña).
# console = no envía nada, imprime el correo y su enlace en la terminal de `pnpm dev`.
# resend  = envío real; requiere RESEND_API_KEY y MAIL_FROM (ver docs/configuracion-externa.md).
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="Guerra Campal <no-reply@tu-dominio.cl>"

CRON_SECRET="change-me-to-a-random-value"

# Opcional: base de datos para los e2e (se vacía en cada corrida).
# E2E_DATABASE_URL="postgres://postgres:postgres@localhost:5432/guerra_campal_e2e"
