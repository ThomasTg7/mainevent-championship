DATABASE_URL="postgres://postgres:postgres@localhost:5432/guerra_campal"

# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-value"

# Sitio público y panel en dominios distintos (el panel en su subdominio).
# En desarrollo se usan estos valores aunque falten; en producción son obligatorios.
# Producción: SITE_URL="https://guerracampal.cl" y ADMIN_URL="https://admin.guerracampal.cl".
# Better Auth usa ADMIN_URL como baseURL (no hace falta BETTER_AUTH_URL).
SITE_URL="http://localhost:3000"
ADMIN_URL="http://admin.localhost:3000"

# Login con Google (opcional). Si faltan, el botón de Google no aparece.
# Ver docs/configuracion-externa.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correos (invitaciones y recuperar contraseña).
# console = no envía nada, imprime el correo y su enlace en la terminal de `pnpm dev`.
# resend  = envío real; requiere RESEND_API_KEY y MAIL_FROM (ver docs/configuracion-externa.md).
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="Guerra Campal <no-reply@tu-dominio.cl>"

CRON_SECRET="change-me-to-a-random-value"

# Opcional: base de datos para los e2e (se vacía en cada corrida).
# E2E_DATABASE_URL="postgres://postgres:postgres@localhost:5432/guerra_campal_e2e"

# Almacenamiento de imágenes: local (carpeta .storage/) o s3 (Cloudflare R2, MinIO, AWS S3).
STORAGE_DRIVER="local"
# Carpeta del driver local (por defecto .storage/ en la raíz del proyecto).
# STORAGE_LOCAL_DIR=""
# Solo con STORAGE_DRIVER="s3":
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="guerra-campal"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://media.tu-dominio.cl"
